# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Environment / secrets ---
.env
.env.*
*.key
secrets*.yaml
