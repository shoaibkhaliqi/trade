# --- Data: datasets are reproducible from downloads, never commit them ---
data/raw/*
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
*.parquet
!assets/data/*.parquet
*.feather
*.h5

# --- Experiment artifacts ---
experiments/*.sqlite
experiments/runs/
notebooks/.ipynb_checkpoints/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
