{
    "name": "Darwin Trading Lab",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "features": {
        "ghcr.io/astral-sh/uv-devcontainer-feature/uv:latest": {}
    },
    "postCreateCommand": "uv venv && uv pip install -e '.[dev,ml]'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "forwardPorts": [8501]
}
